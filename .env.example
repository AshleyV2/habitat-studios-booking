# =============================================================================
# Habitat Studios booking system — installation configuration
# Copy to .env (deploy/scripts/install.sh does this and generates the secrets).
# Never commit .env. Keep it readable by the installer only (chmod 600 .env).
# =============================================================================

# --- Public address -----------------------------------------------------------
# The address customers use. Include a path if the system lives under the main
# website, e.g. https://www.example-main-site.co.uk/book — the app adapts; no rebuild needed.
PUBLIC_URL=https://www.habitatstudio.co.uk
# Hostname for the bundled Caddy HTTPS proxy (no scheme, no path).
HABITAT_DOMAIN=www.habitatstudio.co.uk
# Other addresses staff use, comma-separated (e.g. an internal LAN hostname).
ADDITIONAL_ORIGINS=
# How many reverse proxies sit in front of the app. Bundled Caddy / host nginx /
# Apache / Cloudflare Tunnel = 1. Cloudflare proxy + nginx without real_ip = 2.
TRUST_PROXY=1

# --- Which optional services to run --------------------------------------------
# caddy  = bundled HTTPS reverse proxy on ports 80/443 (recommended)
# tunnel = Cloudflare Tunnel instead of opening ports (set CLOUDFLARE_TUNNEL_TOKEN)
# Empty  = you run nginx/Apache on the host against 127.0.0.1:${APP_PORT}.
COMPOSE_PROFILES=caddy
# Where the app is published on the host for a host-level proxy (loopback only).
APP_BIND=127.0.0.1
APP_PORT=8080
CLOUDFLARE_TUNNEL_TOKEN=

# --- Secrets (generated by install.sh) -----------------------------------------
# Signs session/manage-link tokens. Changing it signs everyone out and invalidates
# links in emails already sent. At least 32 characters.
SESSION_SECRET=
# Password for the local PostgreSQL. Only used inside Docker's private network.
POSTGRES_PASSWORD=

# --- Business (initial values only; edit afterwards in Admin › Settings) ------
BUSINESS_NAME=Habitat Studios
# Start of booking references, e.g. BK-7K3Q9X (2–5 capital letters).
BOOKING_REF_PREFIX=HAB
BUSINESS_TIMEZONE=Europe/London

# --- Stripe (the studio's OWN Stripe account — not ApexBook's) ------------------
# Easier: leave these blank and enter them in Admin › Settings › Payments (saved encrypted).
# Dashboard › Developers › API keys. Use sk_test_… while testing, sk_live_… in production.
STRIPE_SECRET_KEY=
# Dashboard › Developers › Webhooks › endpoint for {PUBLIC_URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Outgoing email (SMTP) -----------------------------------------------------
# Easier: leave these blank and set them in Admin › Settings › Email.
SMTP_HOST=
# 587 with starttls (most providers), 465 with tls, 25/2525 with none (LAN relay only)
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Blank = the business name from Admin › Settings.
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=

# --- Sessions -------------------------------------------------------------------
SESSION_TTL_HOURS=12
SESSION_IDLE_HOURS=4

# --- Backups (the `backup` service) ----------------------------------------------
# Daily time in UTC (HH:MM) and how many days of backups to keep in ./backups.
BACKUP_TIME=03:30
BACKUP_RETENTION_DAYS=30

# --- Logging ---------------------------------------------------------------------
LOG_LEVEL=info
LOG_RETENTION_DAYS=30

# --- Optional: ApexBook management link ----------------------------------------------
# Sends a small health heartbeat (no customer data) to ApexBook. Bookings never
# depend on it. Get the token from ApexBook admin › Systems › this system.
# Easier: leave these blank and set them in Admin › Settings › Monitoring.
APEXBOOK_API_URL=
APEXBOOK_AGENT_TOKEN=
APEXBOOK_HEARTBEAT_MINUTES=5

# --- First-run setup (cloud installs) ---------------------------------------------
# With this set and no administrator yet, visitors are sent to /setup, where the holder
# of the link {PUBLIC_URL}/setup?token=<this> creates the first administrator.
SETUP_TOKEN=

# --- Development only (ignored by Docker, which sets its own) --------------------
# DATABASE_URL=postgresql://habitat:habitat@localhost:5432/habitat?schema=public
# TEST_DATABASE_URL=postgresql://habitat:habitat@localhost:5432/habitat_test?schema=public
